// ── The arithmetic between dimensions ───────────────────────────────

// A distance over an elapsed time.
//
// `UnLength / UnTime -> UnVelocity`, as a named function, because
// novo-lang has no arithmetic operator overloading — see this module's
// header for the exact rule and the exact error a `/` would produce.
pub fn velocity_of(distance: UnLength, elapsed: UnTime) -> UnVelocity
    todo("units-nv.unqty.velocity_of")

// A speed over an elapsed time.
pub fn acceleration_of(change: UnVelocity, elapsed: UnTime) -> UnAcceleration
    todo("units-nv.unqty.acceleration_of")

// A speed times an elapsed time.
pub fn distance_of(speed: UnVelocity, elapsed: UnTime) -> UnLength
    todo("units-nv.unqty.distance_of")

// Mass times acceleration.
pub fn force_of(m: UnMass, a: UnAcceleration) -> UnForce
    todo("units-nv.unqty.force_of")

// Force times distance.
//
// Answers an ENERGY and not a torque, which is the same dimension and a
// different quantity — the distinction the static half exists for, and
// the reason a torque would need its own type rather than an
// annotation.
pub fn work_of(f: UnForce, distance: UnLength) -> UnEnergy
    todo("units-nv.unqty.work_of")

// Energy over elapsed time.
pub fn power_of(e: UnEnergy, elapsed: UnTime) -> UnPower
    todo("units-nv.unqty.power_of")

// Force over area.
pub fn pressure_of(f: UnForce, a: UnArea) -> UnPressure
    todo("units-nv.unqty.pressure_of")

// Two lengths multiplied.
pub fn area_of(a: UnLength, b: UnLength) -> UnArea
    todo("units-nv.unqty.area_of")

// An area times a length.
pub fn volume_of(a: UnArea, h: UnLength) -> UnVolume
    todo("units-nv.unqty.volume_of")

// Mass over volume.
pub fn density_of(m: UnMass, v: UnVolume) -> UnDensity
    todo("units-nv.unqty.density_of")

// Mass times speed.
pub fn momentum_of(m: UnMass, v: UnVelocity) -> UnMomentum
    todo("units-nv.unqty.momentum_of")

// One over an elapsed time.
pub fn frequency_of(period: UnTime) -> UnFrequency
    todo("units-nv.unqty.frequency_of")

// One over a frequency.
pub fn period_of(f: UnFrequency) -> UnTime
    todo("units-nv.unqty.period_of")

// Current times elapsed time.
pub fn charge_of(i: UnCurrent, elapsed: UnTime) -> UnCharge
    todo("units-nv.unqty.charge_of")

// Voltage over current — Ohm's law, one way.
pub fn resistance_of(v: UnVoltage, i: UnCurrent) -> UnResistance
    todo("units-nv.unqty.resistance_of")

// Current times resistance — Ohm's law, the other way.
pub fn voltage_of(i: UnCurrent, r: UnResistance) -> UnVoltage
    todo("units-nv.unqty.voltage_of")

// Voltage times current.
pub fn electrical_power_of(v: UnVoltage, i: UnCurrent) -> UnPower
    todo("units-nv.unqty.electrical_power_of")

// An arc length over a radius.
//
// The one place the dimensionless angle is produced from two lengths,
// and the reason `UnAngle` is a type rather than a bare `Float`.
pub fn angle_of(arc: UnLength, radius: UnLength) -> UnAngle
    todo("units-nv.unqty.angle_of")

// ── Same-dimension arithmetic ───────────────────────────────────────

// Two lengths added.
//
// One `add` per type, because there is no `+` and no trait a `@value`
// struct could carry that a generic `add<T>` could reach through.  The
// repetition is real and the README counts it.
pub fn length_add(a: UnLength, b: UnLength) -> UnLength
    todo("units-nv.unqty.length_add")

// One length quantity subtracted from another.
pub fn length_sub(a: UnLength, b: UnLength) -> UnLength
    todo("units-nv.unqty.length_sub")

// A length scaled by a plain number.
pub fn length_scale(a: UnLength, k: Float) -> UnLength
    todo("units-nv.unqty.length_scale")

// The ratio of two lengths, which is a plain number.
pub fn length_ratio(a: UnLength, b: UnLength) -> Float
    todo("units-nv.unqty.length_ratio")

// Two time quantities added.
pub fn time_add(a: UnTime, b: UnTime) -> UnTime
    todo("units-nv.unqty.time_add")

// One time quantity subtracted from another.
pub fn time_sub(a: UnTime, b: UnTime) -> UnTime
    todo("units-nv.unqty.time_sub")

// A time quantity scaled by a plain number.
pub fn time_scale(a: UnTime, k: Float) -> UnTime
    todo("units-nv.unqty.time_scale")

// Two mass quantities added.
pub fn mass_add(a: UnMass, b: UnMass) -> UnMass
    todo("units-nv.unqty.mass_add")

// A mass quantity scaled by a plain number.
pub fn mass_scale(a: UnMass, k: Float) -> UnMass
    todo("units-nv.unqty.mass_scale")

// Two energy quantities added.
pub fn energy_add(a: UnEnergy, b: UnEnergy) -> UnEnergy
    todo("units-nv.unqty.energy_add")

// Two force quantities added.
pub fn force_add(a: UnForce, b: UnForce) -> UnForce
    todo("units-nv.unqty.force_add")

// Two power quantities added.
pub fn power_add(a: UnPower, b: UnPower) -> UnPower
    todo("units-nv.unqty.power_add")

// ── Temperature, where the two types matter ─────────────────────────

// The difference between two absolute temperatures.
//
// Answers a DELTA.  `temperature_sub(a, b)` where both are in kelvin is
// a plain subtraction; the offset never enters, because both operands
// are already absolute.  The offset enters only in `unconv`, on the way
// in and out of degrees.
pub fn temperature_sub(a: UnTemperature, b: UnTemperature) -> UnTempDelta
    todo("units-nv.unqty.temperature_sub")

// An absolute temperature shifted by a difference.
pub fn temperature_shift(a: UnTemperature, d: UnTempDelta) -> UnTemperature
    todo("units-nv.unqty.temperature_shift")

// Two differences added.
pub fn temp_delta_add(a: UnTempDelta, b: UnTempDelta) -> UnTempDelta
    todo("units-nv.unqty.temp_delta_add")

// A difference scaled.
//
// And note what is NOT here: there is no `temperature_add` and no
// `temperature_scale`.  Adding two absolute temperatures is not an
// operation — 20 °C plus 20 °C is not 40 °C in any system — and
// doubling one is not either.  A library that published them would be
// publishing two functions whose results are meaningless, and their
// absence is the type system doing the work.
pub fn temp_delta_scale(a: UnTempDelta, k: Float) -> UnTempDelta
    todo("units-nv.unqty.temp_delta_scale")

// ── Comparison, which the operator cannot do ────────────────────────

// Whether two lengths are the same.
//
// A named function because `==` on a `@value` type is refused — SPEC
// § 14.5, `E2015`, "compare the fields you mean".  So a units library
// built on the unboxed representation publishes one comparison per
// type, and the README counts that cost against what the representation
// buys.
pub fn length_eq(a: UnLength, b: UnLength) -> Bool
    todo("units-nv.unqty.length_eq")

// Whether two lengths are within a tolerance.
//
// The comparison a caller should almost always make, because a length
// that went through a conversion is a float that went through a
// multiply.  Published beside the exact one so the choice is visible.
pub fn length_near(a: UnLength, b: UnLength, tolerance: UnLength) -> Bool
    todo("units-nv.unqty.length_near")

// How two lengths order.
pub fn length_compare(a: UnLength, b: UnLength) -> Ordering
    todo("units-nv.unqty.length_compare")

// Whether two time quantities are the same.
//
// A named function because `==` on a `@value` type is refused.
pub fn time_eq(a: UnTime, b: UnTime) -> Bool
    todo("units-nv.unqty.time_eq")

// How two time quantities order.
pub fn time_compare(a: UnTime, b: UnTime) -> Ordering
    todo("units-nv.unqty.time_compare")

// Whether two mass quantities are the same.
//
// A named function because `==` on a `@value` type is refused.
pub fn mass_eq(a: UnMass, b: UnMass) -> Bool
    todo("units-nv.unqty.mass_eq")

// Whether two energy quantities are the same.
//
// A named function because `==` on a `@value` type is refused.
pub fn energy_eq(a: UnEnergy, b: UnEnergy) -> Bool
    todo("units-nv.unqty.energy_eq")

// Whether two temperature quantities are the same.
//
// A named function because `==` on a `@value` type is refused.
pub fn temperature_eq(a: UnTemperature, b: UnTemperature) -> Bool
    todo("units-nv.unqty.temperature_eq")

// How two temperature quantities order.
pub fn temperature_compare(a: UnTemperature, b: UnTemperature) -> Ordering
    todo("units-nv.unqty.temperature_compare")

