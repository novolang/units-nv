// untext_tests.nv — reading a quantity with a required dimension, a
// unit expression on its own, and every way a quantity is written out.
//
// RED ON PURPOSE: every body under `src/` is a `todo()`, so every
// assertion here reaches `not implemented: units-nv.<module>.<fn>`.
//
// Where an expected string ends in a unit, the test writes the symbol
// the table answers rather than a spelling of its own, so the test does
// not decide whether degrees Celsius print as `degC` or `°C`.

use std.test
use std.bytes
use undim
use undyn
use unqty
use unconv
use untext

@test
fn test_the_printed_format_is_si_typography_at_a_fixed_precision() [io]
    let f = untext.printed_format(3)
    test.assert_eq(f.significant_digits, 3)
    test.assert(f.middle_dot)
    test.assert(f.superscripts)
    test.assert(f.space_before_unit)

@test
fn test_a_reader_that_knows_the_field_refuses_the_wrong_dimension() [io]
    test.case("a duration field reads 90 s")
    match untext.parse_as("90 s", undim.time())
        Ok(q)  => test.assert(undyn.si_of(q) == 90.0)
        Err(_) => test.assert(false)

    test.case("and refuses a length, against the field")
    match untext.parse_as("3.5 km", undim.time())
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_a_unit_expression_parses_without_a_magnitude() [io]
    test.case("km/h is a speed unit")
    match untext.parse_unit("km/h")
        Err(_) => test.assert(false)
        Ok(u)  =>
            test.assert(undim.dim_eq(u.dim, undim.velocity()))
            test.assert_approx(u.factor, 1000.0 / 3600.0, 1.0e-12)

            test.case("and writing it back gives a spelling that parses to the same dimension")
            match untext.parse_dim(untext.format_unit(u, untext.machine_format()))
                Ok(d)  => test.assert(undim.dim_eq(d, undim.velocity()))
                Err(_) => test.assert(false)

    test.case("the printed form uses a middle dot and superscripts")
    match untext.parse_unit("m/s^2")
        Err(_) => test.assert(false)
        Ok(u)  => test.assert_eq_str(untext.format_unit(u, untext.printed_format(3)), "m·s⁻²")

    test.case("a symbol the table does not know is refused")
    match untext.parse_unit("furlong")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_the_text_splits_into_a_number_span_and_a_unit_span() [io]
    match untext.split_text("3.5 km/h")
        Err(_) => test.assert(false)
        Ok(s)  =>
            test.case("the number is the first three bytes")
            test.assert_eq(s.0, 0)
            test.assert_eq(s.1, 3)

            test.case("and the unit is the four after the space")
            test.assert_eq(s.2, 4)
            test.assert_eq(s.3, 4)

@test
fn test_a_quantity_is_written_in_a_named_unit_and_refused_in_a_wrong_one() [io]
    let f = untext.machine_format()
    match untext.parse("1.5 km")
        Err(_) => test.assert(false)
        Ok(q)  =>
            test.case("1.5 km written in metres is 1500 m")
            match untext.format_in(q, unconv.base_unit(undim.length()), f)
                Ok(s)  => test.assert_eq_str(s, "1500 m")
                Err(_) => test.assert(false)

            test.case("and written in seconds is refused")
            match untext.format_in(q, unconv.base_unit(undim.time()), f)
                Ok(_)  => test.assert(false)
                Err(_) => test.assert(true)

@test
fn test_writing_into_a_cursor_writes_everything_or_nothing() [io]
    let f = untext.machine_format()
    match untext.parse("3.5 km/h")
        Err(_) => test.assert(false)
        Ok(q)  =>
            test.case("the bound covers the eight bytes of 3.5 km/h")
            test.assert(untext.format_bound(q, f) >= 8)

            test.case("a cursor with room receives all eight")
            var roomy = bytes.cursor_be(bytes.zeros(64))
            match untext.format_into(q, f, roomy)
                Ok(n)  => test.assert_eq(n, 8)
                Err(_) => test.assert(false)

            test.case("and a cursor without room receives none of them")
            var tight = bytes.cursor_be(bytes.zeros(2))
            match untext.format_into(q, f, tight)
                Ok(_)  => test.assert(false)
                Err(_) => test.assert_eq(tight.pos(), 0)

@test
fn test_each_typed_quantity_is_written_in_a_named_unit() [io]
    let f = untext.machine_format()

    test.case("1500 m in kilometres is 1.5 km")
    match unconv.unit_named("km")
        Err(_) => test.assert(false)
        Ok(km) =>
            match untext.format_length(unqty.length_m(1500.0), km, f)
                Ok(s)  => test.assert_eq_str(s, "1.5 km")
                Err(_) => test.assert(false)

    test.case("90 s in minutes is 1.5 min")
    match unconv.unit_named("min")
        Err(_) => test.assert(false)
        Ok(m)  =>
            match untext.format_time(unqty.time_s(90.0), m, f)
                Ok(s)  => test.assert_eq_str(s, "1.5 min")
                Err(_) => test.assert(false)

    test.case("10 m/s in kilometres per hour is 36 km/h")
    match unconv.unit_named("km/h")
        Err(_)  => test.assert(false)
        Ok(kmh) =>
            match untext.format_velocity(unqty.velocity_mps(10.0), kmh, f)
                Ok(s)  => test.assert_eq_str(s, "36 km/h")
                Err(_) => test.assert(false)

    test.case("293.15 K as an absolute in degrees Celsius is 20, with the offset")
    match unconv.unit_named("degC")
        Err(_) => test.assert(false)
        Ok(c)  =>
            match untext.format_temperature(unqty.temperature_k(293.15), c, f)
                Ok(s)  => test.assert_eq_str(s, "20 ${c.symbol}")
                Err(_) => test.assert(false)

    test.case("a difference of 20 K in Fahrenheit degrees is 36, without the offset")
    match unconv.unit_named("degF")
        Err(_) => test.assert(false)
        Ok(d)  =>
            match untext.format_temp_delta(unqty.temp_delta_k(20.0), d, f)
                Ok(s)  => test.assert_eq_str(s, "36 ${d.symbol}")
                Err(_) => test.assert(false)
